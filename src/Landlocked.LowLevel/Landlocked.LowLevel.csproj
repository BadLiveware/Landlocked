<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Landlocked.LowLevel</AssemblyName>
    <RootNamespace>Landlocked.LowLevel</RootNamespace>
    <Description>Resource-safe, idiomatic .NET access to Linux Landlock rulesets.</Description>
    <Version>0.1.0</Version>
    <Authors>Landlocked contributors</Authors>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IsTrimmable>true</IsTrimmable>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Landlocked.Native/Landlocked.Native.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
